{
  "name": "zcode-git-worktrees",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Git worktrees plugin for ZCode (plugin lives in plugins/git-worktrees)",
  "scripts": {
    "test": "node --test --test-concurrency=2 tests/unit/*.test.mjs tests/integration/*.test.mjs tests/adversarial/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:adversarial": "node --test tests/adversarial/*.test.mjs"
  }
}
